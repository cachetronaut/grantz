{
  "name": "@cachetronaut/grantz",
  "version": "0.0.0",
  "description": "Scoped, signed, monotonically attenuable delegation tokens for headless agent and tool runs.",
  "keywords": [
    "grantz",
    "capability-tokens",
    "delegation",
    "attenuation",
    "object-capability",
    "agents",
    "typescript",
    "esm"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachetronaut/grantz.git"
  },
  "homepage": "https://github.com/cachetronaut/grantz#readme",
  "bugs": {
    "url": "https://github.com/cachetronaut/grantz/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signer-local": {
      "types": "./dist/signer-local.d.ts",
      "import": "./dist/signer-local.js"
    },
    "./revocation-local": {
      "types": "./dist/revocation-local.d.ts",
      "import": "./dist/revocation-local.js"
    },
    "./revocation-postgres": {
      "types": "./dist/revocation-postgres.d.ts",
      "import": "./dist/revocation-postgres.js"
    },
    "./revocation-convex": {
      "types": "./dist/revocation-convex.d.ts",
      "import": "./dist/revocation-convex.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify && pnpm build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin"
      ],
      "cpu": [
        "current",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/pg": "^8.15.5",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
